# Copie para .env e preencha. O .env nunca vai para o git.

# Chave do Google AI Studio (plano gratuito): https://aistudio.google.com/apikey
LLM_API_KEY=

# Opcionais: qualquer API compatível com OpenAI funciona.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite

# Avaliação (scripts/avaliar.py): a chave de avaliação NUNCA vai neste arquivo (nem no .env da raiz).
# Use EVAL_ENV_FILE apontando para um arquivo fora do repositório que tenha EVAL_LLM_API_KEY.
# A demo recusa subir se EVAL_LLM_API_KEY estiver no ambiente dela.
# EVAL_ENV_FILE=

# Teto diário de perguntas da demo (acima disso, só gravações). Padrão: 80.
# DEMO_TETO_DIARIO=80

# Só teste local/CI: libera Postgres em endereço interno (sem isso, só IP público).
# PG_PERMITIR_INTERNO=1
